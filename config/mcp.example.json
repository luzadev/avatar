{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/tuonome/Documents"
      ]
    },
    "remoto": {
      "url": "https://esempio.it/mcp",
      "headers": {
        "Authorization": "Bearer TOKEN"
      },
      "disabled": true
    },
    "cua-driver": {
      "command": "/Users/tuonome/.local/bin/cua-driver",
      "args": [
        "mcp"
      ],
      "tools": [
        "list_apps",
        "list_windows",
        "get_window_state",
        "verify_state",
        "launch_app",
        "bring_to_front",
        "invoke_menu",
        "click",
        "double_click",
        "right_click",
        "type_text",
        "press_key",
        "hotkey",
        "set_value",
        "scroll",
        "get_desktop_state",
        "zoom",
        "clipboard_read",
        "clipboard_write",
        "get_browser_state",
        "browser_navigate",
        "browser_click",
        "browser_type"
      ],
